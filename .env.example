# ===================================================================
# PettyCash Pro - Production Environment Configuration (.env)
# ===================================================================
# NOTE: The application is designed to be 100% turnkey out-of-the-box.
# It automatically runs on free static hosting (Vercel, Netlify, Cloudflare)
# with zero setup required.
#
# If you want central real-time database and file bucket storage across
# multiple distinct devices/phones, connect a free Supabase project below:
# ===================================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
STORAGE_BUCKET_NAME=receipts
